# docker compose が読み込む環境変数のサンプル。
# cp .env.example .env としてコピーしてから必要に応じて変更してください。
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=appdb

# S3 から API を呼ぶ場合に許可するオリジン。研修中は * のままでOK
# 例: CORS_ORIGINS=http://my-bucket.s3-website-ap-northeast-1.amazonaws.com
CORS_ORIGINS=*

# 共有 DynamoDB モードで画像を置く S3 バケット (講師が scripts/create_image_bucket.sh で作る)。
# ここに書いた名前が設定画面の「画像用 S3 バケット」に最初から入る。設定画面で上書きもできる。
IMAGE_BUCKET=handson-chat-images-255103685154
